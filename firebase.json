{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "farose-fable",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "firestore.rules",
      "README.md",
      "LICENSE",
      "NOTICE",
      "docs/**",
      "**/.*",
      "data/**",
      "scripts/**",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
